            },
            "appointmentId": {
              "bsonType": "string",
              "pattern": "^[a-f0-9]{24}$"
            },
            "patientId": {
              "bsonType": "string",
              "pattern": "^[a-f0-9]{24}$"
            },
            "scheduledFor": {
              "bsonType": "date"
            },
            "templateVersion": {
              "enum": [
                "followup-v1"
              ]
            },
            "ownerToken": {
              "bsonType": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "state": {
              "enum": [
                "reserved",
                "dispatching",
                "accepted",
                "unconfirmed",
                "uncertain"
              ]
            },
            "createdAt": {
              "bsonType": "date"
            },
            "attemptStartedAt": {
              "bsonType": "date"
            },
            "completedAt": {
              "bsonType": "date"
            },
            "providerAccepted": {
              "bsonType": "bool"
            }
          }
        }
      },
