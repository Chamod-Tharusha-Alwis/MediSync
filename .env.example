# ==============================================================
# MEDISYNC GLOBAL ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE)
# ==============================================================
# Copy these keys into your local server/.env, ml-engine/.env, and
# client/.env files and configure values appropriately for local running.

# ─── SERVER CONFIGURATION (server/.env) ───────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection URIs (Local MongoDB on port 27017 is strictly prohibited)
# Live/Production DB targets production Atlas cluster '/test' with primary user:
MONGO_URI=mongodb+srv://<PROD_DB_USER>:<PROD_DB_PASS>@<PROD_CLUSTER_HOST>.mongodb.net/test?retryWrites=true&w=majority&appName=MediSync
# Automated Test DB MUST target a SEPARATE, DEDICATED Atlas QA cluster (never share production host):
# Database must be '/medisync_automated_test' with user restricted to readWrite@medisync_automated_test ONLY:
MONGO_URI_TEST=mongodb+srv://medisync_qa_runner:<RESTRICTED_TEST_PASS>@<SEPARATE_QA_CLUSTER_HOST>.mongodb.net/medisync_automated_test?authSource=admin

# Authentication Token Secrets
JWT_SECRET=<YOUR_32_BYTE_HEX_JWT_SECRET>
JWT_REFRESH_SECRET=<YOUR_32_BYTE_HEX_JWT_REFRESH_SECRET>

# PII Database Cryptographic Field Encryption & HashiCorp Vault
ENCRYPTION_KEY=<YOUR_32_CHARACTER_HEX_ENCRYPTION_KEY>
# Dev-only root token for the local HashiCorp Vault container (never use in production)
VAULT_TOKEN=myroot
VAULT_URL=http://127.0.0.1:8200

# Redis Cache & Rate Limiter
REDIS_URL=redis://127.0.0.1:6379

# Transactional Email Dispatch (Resend HTTPS REST API)
EMAIL_PROVIDER=resend
EMAIL_USER=<YOUR_SENDER_EMAIL>
# emailService.js reads RESEND_API_KEY first, with fallback aliases: RESEND_SMTP_PASS, RESEND_KEY, RESEND_APIKEY
RESEND_API_KEY=<YOUR_RESEND_API_KEY>
RESEND_SMTP_PASS=<YOUR_RESEND_API_KEY>
# Note: onboarding@resend.dev only delivers to the Resend account owner; a verified custom domain is required for other recipients.
RESEND_FROM_ADDRESS=MediSync System <onboarding@resend.dev>

# Cloudinary Secure Blob Store (Encrypted PDF Lab Reports)
CLOUDINARY_CLOUD_NAME=<YOUR_CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_CLOUDINARY_API_SECRET>

# Flask Python ML Engine Authentication & Routing
INTERNAL_API_KEY=<YOUR_64_CHARACTER_HEX_INTERNAL_API_KEY>
ML_ENGINE_URL=http://127.0.0.1:5001

# Seed & Bootstrap Credentials
SEED_TEST_PASSWORD=<YOUR_SEED_TEST_PASSWORD>
ADMIN_PASSWORD=<YOUR_SUPER_ADMIN_PASSWORD>

# ─── PYTHON ML ENGINE CONFIGURATION (ml-engine/.env) ──────────
NODE_API_URL=http://localhost:5000
# INTERNAL_API_KEY must match the key declared in server/.env
# INTERNAL_API_KEY=<YOUR_64_CHARACTER_HEX_INTERNAL_API_KEY>
