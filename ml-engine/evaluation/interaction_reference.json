  "source": "US FDA prescription drug labels (openFDA drug label API; the same labels are published on DailyMed)",
  "definitions": {
    "interacting": "The cited label describes an interaction between the two drugs: a change in drug levels, a dose limit, a warning, or a contraindication.",
    "non_interacting": "The cited label states that a study found no interaction, or no clinically significant interaction, between the two drugs. It is a statement by that one label, not proof that no reference lists any interaction."
  },
  "selectionRules": [
    "Both drugs must have a single-ingredient product in the 3,000-entry catalogue that the checker resolves.",
    "Pairs were chosen from label text before the checker was run on any of them.",
    "A pair was dropped when labels disagreed (for example digoxin with ivabradine is kept as interacting because the digoxin label warns of bradycardia).",
    "basis is a paraphrase of the label, not a quotation."
  ],
